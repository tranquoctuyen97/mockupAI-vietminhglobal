{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pod-idea-card-v1.schema.json",
  "title": "POD Idea Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ideaId",
    "status",
    "title",
    "clusterId",
    "seedKeywordIds",
    "audience",
    "buyer",
    "wearerOrUser",
    "occasion",
    "emotion",
    "productTypes",
    "conceptType",
    "creativeBrief",
    "evidence",
    "scores",
    "gates",
    "rejectionReasons",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "pod-idea-card/v1" },
    "ideaId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["hypothesis", "research-qualified", "rejected"] },
    "title": { "type": "string", "minLength": 1 },
    "clusterId": { "type": "string", "minLength": 1 },
    "seedKeywordIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "audience": { "type": "string", "minLength": 1 },
    "buyer": { "type": "string", "minLength": 1 },
    "wearerOrUser": { "type": "string", "minLength": 1 },
    "occasion": { "type": ["string", "null"] },
    "emotion": { "type": "string", "minLength": 1 },
    "productTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "conceptType": {
      "enum": ["text-led", "illustration-led", "personalization", "gift-occasion", "identity-insider"]
    },
    "creativeBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "visualDirection", "typography", "personalizationFields", "avoid"],
      "properties": {
        "hook": { "type": "string", "minLength": 1 },
        "visualDirection": { "type": "string", "minLength": 1 },
        "typography": { "type": ["string", "null"] },
        "personalizationFields": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportingKeywordIds", "sourceTypes", "reasons", "caveats"],
      "properties": {
        "supportingKeywordIds": { "type": "array", "items": { "type": "string" } },
        "sourceTypes": { "type": "array", "items": { "type": "string" } },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "caveats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDiversity",
        "recency",
        "purchaseIntent",
        "marketplaceEvidence",
        "trendSustainability",
        "buyerClarity",
        "productFit",
        "creativeDepth",
        "risk"
      ],
      "properties": {
        "sourceDiversity": { "$ref": "#/$defs/score" },
        "recency": { "$ref": "#/$defs/score" },
        "purchaseIntent": { "$ref": "#/$defs/score" },
        "marketplaceEvidence": { "$ref": "#/$defs/score" },
        "trendSustainability": { "$ref": "#/$defs/score" },
        "buyerClarity": { "$ref": "#/$defs/score" },
        "productFit": { "$ref": "#/$defs/score" },
        "creativeDepth": { "$ref": "#/$defs/score" },
        "risk": { "$ref": "#/$defs/score" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipRisk",
        "sensitiveContent",
        "buyerClarity",
        "productFit",
        "creativeDepth",
        "singleSourceTrend",
        "purchaseIntent"
      ],
      "properties": {
        "ipRisk": { "enum": ["pass", "review", "fail"] },
        "sensitiveContent": { "enum": ["pass", "review", "fail"] },
        "buyerClarity": { "enum": ["pass", "fail"] },
        "productFit": { "enum": ["pass", "fail"] },
        "creativeDepth": { "enum": ["pass", "fail"] },
        "singleSourceTrend": { "enum": ["pass", "review", "fail"] },
        "purchaseIntent": { "enum": ["pass", "review", "fail"] }
      }
    },
    "rejectionReasons": { "type": "array", "items": { "type": "string" } },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 5 }
  }
}
