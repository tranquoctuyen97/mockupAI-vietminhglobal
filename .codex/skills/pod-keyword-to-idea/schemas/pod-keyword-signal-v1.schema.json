{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pod-keyword-signal-v1.schema.json",
  "title": "POD Keyword Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "keywordId",
    "keyword",
    "aliases",
    "firstSeenAt",
    "lastSeenAt",
    "sourceSummary",
    "weekly",
    "platformSignals",
    "provenance",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": "pod-keyword-signal/v1" },
    "keywordId": { "type": "string", "minLength": 1 },
    "keyword": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "lastSeenAt": { "type": "string", "format": "date-time" },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCount", "observationCount", "sources"],
      "properties": {
        "sourceCount": { "type": "integer", "minimum": 0 },
        "observationCount": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "weekly": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "sources"],
        "properties": {
          "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "demand": { "type": ["number", "null"] },
          "listings": { "type": ["number", "null"] }
        }
      }
    },
    "platformSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autocomplete", "googleTrends", "etsyMarketplace", "tiktok", "metaAds"],
      "properties": {
        "autocomplete": { "type": ["object", "null"] },
        "googleTrends": { "type": ["object", "null"] },
        "etsyMarketplace": { "type": ["object", "null"] },
        "tiktok": {
          "type": ["array", "null"],
          "items": { "type": "object" }
        },
        "metaAds": {
          "type": ["array", "null"],
          "items": { "type": "object" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observationId", "source", "query", "sourceUrl", "capturedAt"],
        "properties": {
          "observationId": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "query": { "type": ["string", "null"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "capturedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "warnings", "hasCanonicalProvenance"],
      "properties": {
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hasCanonicalProvenance": { "type": "boolean" }
      }
    }
  }
}
